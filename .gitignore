# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp

# 익스포터 개발용 빌드 (수렴 작업이 target/을 쓰는 동안 따로 빌드할 때)
tools/spot-exporter/target-dev/
# 프리플랍 값 추출용 플랍 표본. 재생성 가능한 중간 산출물이라 커밋하지 않는다.
scripts/data/flopev/
scripts/data/flopev-*/
scripts/data/pipeline-status.json

# 파이프라인 재개용 곁기록
public/postflop/*/.done/
scripts/data/pipeline.log
dev.log
scripts/data/boards-run.log
# 새 보드 세트는 저장소가 아니라 Supabase Storage에만 올린다(scripts/upload-boards.ts).
public/postflop/*-ip/
public/postflop/*-sb/
